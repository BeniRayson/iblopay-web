{
  "name": "iblopay-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "ng serve iblopay-admin",
    "start:admin": "ng serve iblopay-admin",
    "start:providers": "ng serve iblopay-providers",
    "start:public": "ng serve iblopay-public",
    "start:all": "concurrently -n admin,providers,public \"npm run start:admin\" \"npm run start:providers\" \"npm run start:public\"",
    "build": "ng build iblopay-admin",
    "build:admin": "ng build iblopay-admin",
    "build:providers": "ng build iblopay-providers",
    "build:public": "ng build iblopay-public",
    "build:all": "npm run build:admin && npm run build:providers && npm run build:public"
  },
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/ssr": "^17.0.0",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "chart.js": "^4.5.1",
    "express": "^4.18.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.12",
    "@angular/cli": "^17.3.12",
    "@angular/compiler-cli": "^17.0.0",
    "@types/express": "^4.17.19",
    "@types/jasmine": "^4.3.1",
    "@types/node": "^20.11.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.4.5"
  },
  "private": true
}
